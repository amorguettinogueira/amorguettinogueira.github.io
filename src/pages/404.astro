---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Página não encontrada"
  description="Esta página não existe."
  fontsHref="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,600&family=Pinyon+Script&family=Quicksand:wght@500;600&display=swap"
>
  <main class="wrap">
    <p class="pre">ops…</p>
    <h1>Esta página não existe</h1>
    <p class="sub">Mas o carinho continua todo aqui, ano a ano.</p>
    <a href="/">Voltar ao início</a>
  </main>
</BaseLayout>

<!-- Same fonts and palette as the gallery (src/pages/index.astro), UX-22. -->
<style is:global>
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem 1.25rem;
    box-sizing: border-box;
    background:
      radial-gradient(ellipse 130% 70% at 10% 5%, hsl(340 90% 85% / 0.6) 0%, transparent 55%),
      radial-gradient(ellipse 80% 60% at 88% 18%, hsl(290 55% 83% / 0.45) 0%, transparent 50%),
      linear-gradient(155deg, hsl(335 90% 95%) 0%, hsl(320 50% 92%) 40%, hsl(35 80% 96%) 100%);
    font-family: "Quicksand", sans-serif;
    font-weight: 500;
    color: hsl(340 40% 30%);
    text-align: center;
  }
  .wrap { max-width: 34rem; }
  .pre {
    margin: 0;
    font-family: "Pinyon Script", cursive;
    font-size: clamp(2.2rem, 7vw, 2.8rem);
    color: hsl(320 35% 45%);
  }
  h1 {
    margin: 0 0 1rem;
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2.4rem, 8vw, 3.6rem);
    line-height: 1.05;
    color: hsl(340 60% 36%);
  }
  .sub {
    margin: 0 0 2.25rem;
    font-size: 1.1875rem;
    line-height: 1.5;
  }
  a {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    background: hsl(340 58% 40%);
    color: #fff;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 24px -12px hsl(340 60% 30% / 0.6);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  a:hover { transform: translateY(-2px); background: hsl(340 58% 34%); }
  a:focus-visible { outline: 3px solid hsl(340 60% 36%); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } }
</style>
