---
// The video years (2014, 2015, 2020) inside the site instead of a jump to
// YouTube (backlog UX-24): the video embedded, plus the transcript that was
// already public at /<ano>/video-text.txt.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavAnos from "../../components/NavAnos.astro";
import { ANOS, idade, type Ano } from "../../data/anos";

export function getStaticPaths() {
  return ANOS.filter((a) => a.tipo === "video").map((a) => ({
    params: { video: String(a.ano) },
    props: { a },
  }));
}

const { a } = Astro.props as { a: Ano };

// Build runs from the repo root; the transcript stays where its URL already is.
const texto = readFileSync(join(process.cwd(), "public", String(a.ano), "video-text.txt"), "utf8");
const paragrafos = texto
  .replace(/\r\n/g, "\n")
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean)
  .map((p) => p.split("\n").map((l) => l.trim()));
---

<BaseLayout
  title={`Para a Mi — 30/09/${a.ano}`}
  description={`Vídeo de aniversário para a Michelle, ${a.ano}, com a transcrição.`}
  fontsHref="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Quicksand:wght@500;600&display=swap"
  ogImage={a.capa}
>
  <a href="/" class="voltar">← início</a>

  <main class="video-ano">
    <header class="cabeca">
      <p class="cabeca__data">30 de setembro de {a.ano}</p>
      <h1 class="cabeca__titulo">{idade(a.ano)} anos</h1>
    </header>

    <div class="player">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${a.youtube}`}
        title={`Vídeo de aniversário de ${a.ano}`}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
    <p class="externo">
      <a href={`https://youtu.be/${a.youtube}`} target="_blank" rel="noopener noreferrer">Abrir no YouTube</a>
    </p>

    <section class="transcricao" aria-labelledby="transcricao-titulo">
      <h2 id="transcricao-titulo">O que se ouve no vídeo</h2>
      {paragrafos.map((linhas) => (
        <p>
          {linhas.map((l, i) => (
            <>
              {i > 0 && <br />}
              {l}
            </>
          ))}
        </p>
      ))}
    </section>

    <NavAnos ano={a.ano} />
  </main>
</BaseLayout>

<style is:global>
  :root {
    --papel: hsl(335 70% 97%);
    --tinta: hsl(330 25% 18%);
    --rosa: hsl(340 50% 34%);
    --rosa-media: hsl(340 30% 40%);
  }
  *, *::before, *::after { box-sizing: border-box; }
  body {
    margin: 0;
    background: linear-gradient(170deg, hsl(335 80% 93%) 0%, var(--papel) 28rem);
    color: var(--tinta);
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1.3125rem, 1.2rem + 0.4vw, 1.4375rem); /* Cormorant runs small: ~21px */
    line-height: 1.6;
  }
  .voltar {
    position: absolute;
    top: 0.25rem;
    left: 0.5rem;
    padding: 0.75rem;
    color: var(--rosa-media);
    font-style: italic;
    text-decoration: none;
  }
  .voltar:hover, .voltar:focus-visible { color: var(--rosa); text-decoration: underline; }
  .video-ano {
    width: min(100% - 2.5rem, 46rem);
    margin: 0 auto;
    padding: 5rem 0 5rem;
  }
  .cabeca { text-align: center; margin-bottom: 2.5rem; }
  .cabeca__data {
    margin: 0 0 0.5rem;
    color: var(--rosa);
    font-style: italic;
  }
  .cabeca__titulo {
    margin: 0;
    font-size: clamp(3rem, 12vw, 4.5rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1;
    color: var(--rosa);
  }
  .player {
    aspect-ratio: 16 / 9;
    border-radius: 1rem;
    overflow: hidden;
    background: hsl(330 25% 18%);
    box-shadow: 0 18px 40px -18px hsl(340 60% 30% / 0.45);
  }
  .player iframe { display: block; width: 100%; height: 100%; border: 0; }
  .externo {
    margin: 0.5rem 0 0;
    text-align: right;
    font-family: "Quicksand", sans-serif;
    font-size: 1.125rem;
  }
  .externo a { display: inline-block; padding: 0.6rem 0; color: var(--rosa); }
  .transcricao { margin-top: 3.5rem; }
  .transcricao h2 {
    margin: 0 0 1.5rem;
    font-size: 1.75rem;
    font-style: italic;
    font-weight: 600;
    color: var(--rosa);
  }
  .transcricao p { margin: 0 0 1.1em; }
  a:focus-visible { outline: 2px solid var(--rosa); outline-offset: 2px; }
</style>
