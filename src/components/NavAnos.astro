---
// "← 2024 · todas as cartas · 2026 →" at the end of each letter (backlog UX-09).
// A page can set --nav-anos-cor (text colour, light tone) and --nav-anos-topo
// (the gap above) on an ancestor; 2023 and 2024 do.
// Plain CSS on purpose: it must look the same on the Tailwind page (2025) and
// on the plain-CSS pages.
import { vizinhos } from "../data/anos";

interface Props {
  ano: number;
  /** "claro" for light pages, "escuro" for dark ones. */
  tom?: "claro" | "escuro";
}

const { ano, tom = "claro" } = Astro.props;
const { anterior, proximo } = vizinhos(ano);
---

<nav class={`nav-anos nav-anos--${tom}`} aria-label="Outras cartas">
  {anterior ? (
    <a class="nav-anos__ano" href={anterior.href} rel="prev">← {anterior.ano}</a>
  ) : (
    <span class="nav-anos__vazio" aria-hidden="true"></span>
  )}
  <a class="nav-anos__todas" href="/">todas as cartas</a>
  {proximo ? (
    <a class="nav-anos__ano" href={proximo.href} rel="next">{proximo.ano} →</a>
  ) : (
    <span class="nav-anos__vazio" aria-hidden="true"></span>
  )}
</nav>

<style>
  .nav-anos {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
    width: min(100%, 36rem);
    /* A page can tighten the gap above with --nav-anos-topo (2024 does). */
    margin: var(--nav-anos-topo, 3.5rem) auto 0;
    font-family: inherit;
    font-size: 1.1875rem; /* 19px: nada com informação abaixo do corpo (CLAUDE.md §3) */
    font-style: italic;
    line-height: 1.3;
  }
  .nav-anos a {
    /* 44px+ touch target */
    display: inline-block;
    padding: 0.75rem 0.5rem;
    white-space: nowrap;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
  }
  .nav-anos a:hover,
  .nav-anos a:focus-visible {
    text-decoration-color: currentColor;
  }
  .nav-anos a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .nav-anos__ano:first-child { justify-self: start; }
  .nav-anos__ano:last-child { justify-self: end; }
  .nav-anos__todas { text-align: center; }
  .nav-anos--claro { color: var(--nav-anos-cor, hsl(340 45% 32%)); }
  .nav-anos--escuro { color: hsl(30 40% 96%); }
</style>
