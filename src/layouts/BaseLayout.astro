---
// Shared document shell for every page of the site (gallery, each year's
// route, the video years, 404).
interface Props {
  title: string;
  description?: string;
  /** Google Fonts (or any) stylesheet href to load for this page. */
  fontsHref?: string;
  /** Optional Open Graph image URL (absolute path from site root). */
  ogImage?: string;
  /** Describes the preview image. Defaults to a generic line about the photo. */
  ogImageAlt?: string;
  /** Pixel size of ogImage. Every cover is 622×415. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Colour of the phone's browser bar (Chrome on Android). */
  themeColor?: string;
  /** Language of the document. */
  lang?: string;
}

const {
  title,
  description = "",
  fontsHref,
  ogImage,
  ogImageAlt = "Foto da Michelle",
  ogImageWidth = 622,
  ogImageHeight = 415,
  themeColor = "#fbe3ec",
  lang = "pt-BR",
} = Astro.props;

// Open Graph requires an absolute URL; WhatsApp drops the preview image otherwise.
const ogImageUrl = ogImage && new URL(ogImage, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph (WhatsApp, Facebook) + Twitter/X -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="michellenogueira.info" />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content={String(ogImageWidth)} />
          <meta property="og:image:height" content={String(ogImageHeight)} />
          <meta property="og:image:alt" content={ogImageAlt} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />

    {
      fontsHref && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link href={fontsHref} rel="stylesheet" />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
